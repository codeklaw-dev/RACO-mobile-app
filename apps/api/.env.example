# Copy to .env for local development. Never commit the real file.
PORT=8787

# Supabase project (Settings -> API). The service role key bypasses RLS and
# must only ever live on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
# Optional: override the chat model.
CHAT_MODEL=claude-opus-5-5

# Comma-separated origins allowed to call the API from a browser (Expo web).
CORS_ORIGINS=http://localhost:8081
