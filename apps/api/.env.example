# Copy to .env for local development. Never commit the real file.
PORT=8787

# Supabase project (Settings -> API). The service role key bypasses RLS and
# must only ever live on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Which model serves chat and voice onboarding.
#   anthropic          Claude (needs ANTHROPIC_API_KEY)
#   openai-compatible  your own server with an OpenAI-style /v1 API
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# Optional overrides for Claude (defaults: claude-opus-5-5 / claude-haiku-5-5).
# CHAT_MODEL=
# VOICE_MODEL=

# For LLM_PROVIDER=openai-compatible:
# LLM_BASE_URL=https://your-model-server.example.com/v1
# LLM_API_KEY=
# CHAT_MODEL=the-model-name-your-server-lists
# VOICE_MODEL=  (optional; defaults to CHAT_MODEL)

# Comma-separated origins allowed to call the API from a browser (Expo web).
CORS_ORIGINS=http://localhost:8081
