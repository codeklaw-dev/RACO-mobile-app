# Copy to .env (never commit it). Only EXPO_PUBLIC_* values reach the app,
# and none of these are secrets.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The RACO API (apps/api). On a physical phone use your computer's LAN IP,
# e.g. http://192.168.1.20:8787, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Shown in the app. The AI provider is named in the consent prompt before any
# chat data is sent (App Store Guideline 5.1.2(i)); set it to whoever serves
# replies.
# EXPO_PUBLIC_AI_PROVIDER=Anthropic
# EXPO_PUBLIC_SUPPORT_EMAIL=support@racoai.io
# EXPO_PUBLIC_PRIVACY_URL=https://racoai.io/privacy
# EXPO_PUBLIC_TERMS_URL=https://racoai.io/terms

# Direct LLM integration for standalone Expo Go / demo mode:
# EXPO_PUBLIC_LLM_CHAT_URL=https://your-model-server.example.com/v1/chat/completions
# EXPO_PUBLIC_LLM_MODEL=qwen3
# EXPO_PUBLIC_LLM_API_KEY=your-api-key
